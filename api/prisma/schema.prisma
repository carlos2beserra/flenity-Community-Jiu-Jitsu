generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  RECEPTION
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELED
}

enum PaymentMethod {
  PIX
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
}

enum LeadStatus {
  NEW
  CONTACTED
  TRIAL
  CONVERTED
  LOST
}

enum ChatSenderRole {
  STUDENT
  STAFF
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum CommunityPostKind {
  POST
  REEL
}

/// Eixos das trilhas "Descomplicando a Faixa X".
enum TrackCategory {
  GUARD
  PASS
  CONTROL
  SUBMISSION
}

enum CommunityNotificationType {
  LIKE
  COMMENT
  FOLLOW
}

model Academy {
  id               String   @id @default(uuid())
  name             String
  blockOverdueDays Int      @default(10)
  createdAt        DateTime @default(now())

  users            User[]
  students         Student[]
  modalities       Modality[]
  plans            Plan[]
  memberships      Membership[]
  invoices         Invoice[]
  classes          ClassSchedule[]
  checkIns         CheckIn[]
  leads            Lead[]
  conversations    ChatConversation[]
  communityPosts   CommunityPost[]
  communityInvites CommunityInvite[]
  communityMedia   CommunityMedia[]
  communityStories CommunityStory[]
  communityNotices CommunityNotification[]
  communityMembers CommunityMember[]
  trackLessons     TrackLesson[]
}

model StudentAccount {
  id           String   @id @default(uuid())
  email        String?
  passwordHash String?
  createdAt    DateTime @default(now())

  students Student[]

  @@index([email])
}

model User {
  id           String   @id @default(uuid())
  academyId    String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())

  academy           Academy            @relation(fields: [academyId], references: [id], onDelete: Cascade)
  classes           ClassSchedule[]
  chatConversations ChatConversation[] @relation("StaffConversations")
  communityMember   CommunityMember?
  deviceCredentials DeviceCredential[]

  @@index([academyId])
}

model Student {
  id           String        @id @default(uuid())
  academyId    String
  accountId    String?
  name         String
  email        String?
  phone        String?
  cpf          String?
  birthDate    DateTime?
  status       StudentStatus @default(ACTIVE)
  notes        String?
  /// Senha do app do aluno (null = acesso ao app não liberado)
  passwordHash String?
  createdAt    DateTime      @default(now())

  academy           Academy            @relation(fields: [academyId], references: [id], onDelete: Cascade)
  account           StudentAccount?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  memberships       Membership[]
  invoices          Invoice[]
  checkIns          CheckIn[]
  ranks             StudentRank[]
  chatConversations ChatConversation[] @relation("StudentConversations")
  communityInvites  CommunityInvite[]
  communityMember   CommunityMember?
  deviceCredentials DeviceCredential[]
  trackProgress     TrackProgress[]

  @@unique([accountId, academyId])
  @@index([academyId, name])
}

model CommunityInvite {
  id         String    @id @default(uuid())
  academyId  String
  studentId  String
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([academyId, studentId, acceptedAt])
}

/// Perfil social de alguém da academia: um aluno OU um membro da equipe (professor, administração).
/// Todo conteúdo da comunidade pertence a um perfil, nunca diretamente ao aluno ou ao usuário.
model CommunityMember {
  id            String   @id @default(uuid())
  academyId     String
  studentId     String?  @unique
  userId        String?  @unique
  bio           String?  @db.VarChar(150)
  avatarMediaId String?  @unique
  createdAt     DateTime @default(now())

  academy           Academy                 @relation(fields: [academyId], references: [id], onDelete: Cascade)
  student           Student?                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user              User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarMedia       CommunityMedia?         @relation("MemberAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  ownedMedia        CommunityMedia[]        @relation("MediaOwner")
  posts             CommunityPost[]
  likes             CommunityPostLike[]
  comments          CommunityPostComment[]
  saves             CommunityPostSave[]
  following         CommunityFollow[]       @relation("Follower")
  followers         CommunityFollow[]       @relation("Following")
  stories           CommunityStory[]
  storyViews        CommunityStoryView[]
  notifications     CommunityNotification[] @relation("NotificationRecipient")
  notificationsSent CommunityNotification[] @relation("NotificationActor")

  @@index([academyId])
}

model CommunityPost {
  id        String            @id @default(uuid())
  academyId String
  memberId  String
  kind      CommunityPostKind @default(POST)
  content   String            @default("") @db.VarChar(2200)
  createdAt DateTime          @default(now())

  academy       Academy                 @relation(fields: [academyId], references: [id], onDelete: Cascade)
  author        CommunityMember         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  likes         CommunityPostLike[]
  comments      CommunityPostComment[]
  media         CommunityPostMedia[]
  saves         CommunityPostSave[]
  notifications CommunityNotification[]

  @@index([academyId, createdAt])
  @@index([academyId, kind, createdAt])
  @@index([memberId, createdAt])
}

/// Foto ou vídeo enviado por um perfil. O binário fica no disco (MEDIA_DIR), nunca no banco.
model CommunityMedia {
  id         String    @id @default(uuid())
  academyId  String
  ownerId    String
  kind       MediaKind
  mimeType   String
  sizeBytes  Int
  storageKey String    @unique
  createdAt  DateTime  @default(now())

  academy   Academy             @relation(fields: [academyId], references: [id], onDelete: Cascade)
  owner     CommunityMember     @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  avatarOf  CommunityMember?    @relation("MemberAvatar")
  postMedia CommunityPostMedia?
  stories   CommunityStory[]
  lesson    TrackLesson?

  @@index([academyId, ownerId])
}

model CommunityPostMedia {
  postId   String
  mediaId  String @unique
  position Int

  post  CommunityPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  media CommunityMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([postId, position])
}

model CommunityFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  CommunityMember @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following CommunityMember @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
}

model CommunityPostSave {
  postId    String
  memberId  String
  createdAt DateTime @default(now())

  post   CommunityPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  member CommunityMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([postId, memberId])
  @@index([memberId, createdAt])
}

/// Flash: foto ou vídeo visível por 24 horas.
model CommunityStory {
  id        String   @id @default(uuid())
  academyId String
  memberId  String
  mediaId   String
  caption   String?  @db.VarChar(200)
  createdAt DateTime @default(now())
  expiresAt DateTime

  academy Academy              @relation(fields: [academyId], references: [id], onDelete: Cascade)
  author  CommunityMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  media   CommunityMedia       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  views   CommunityStoryView[]

  @@index([academyId, expiresAt])
  @@index([memberId, expiresAt])
}

model CommunityStoryView {
  storyId  String
  memberId String
  viewedAt DateTime @default(now())

  story  CommunityStory  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  member CommunityMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([storyId, memberId])
}

model CommunityNotification {
  id          String                    @id @default(uuid())
  academyId   String
  recipientId String
  actorId     String
  type        CommunityNotificationType
  postId      String?
  readAt      DateTime?
  createdAt   DateTime                  @default(now())

  academy   Academy         @relation(fields: [academyId], references: [id], onDelete: Cascade)
  recipient CommunityMember @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     CommunityMember @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post      CommunityPost?  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

model CommunityPostLike {
  id        String   @id @default(uuid())
  postId    String
  memberId  String
  createdAt DateTime @default(now())

  post   CommunityPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  member CommunityMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([postId, memberId])
}

model CommunityPostComment {
  id        String   @id @default(uuid())
  postId    String
  memberId  String
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  post   CommunityPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  member CommunityMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Modality {
  id        String @id @default(uuid())
  academyId String
  name      String

  academy  Academy         @relation(fields: [academyId], references: [id], onDelete: Cascade)
  belts    Belt[]
  plans    PlanModality[]
  classes  ClassSchedule[]
  checkIns CheckIn[]
  ranks    StudentRank[]

  @@unique([academyId, name])
}

/// Faixa/graduação de uma modalidade. `order` define a sequência (0 = inicial).
model Belt {
  id         String @id @default(uuid())
  modalityId String
  name       String
  color      String @default("#ffffff")
  order      Int
  /// Aulas mínimas (check-ins na modalidade) desde a última promoção para ficar apto.
  minClasses Int    @default(40)
  /// Quantidade de graus antes de trocar de faixa.
  maxDegrees Int    @default(4)

  modality Modality      @relation(fields: [modalityId], references: [id], onDelete: Cascade)
  ranks    StudentRank[]
  lessons  TrackLesson[]

  @@unique([modalityId, order])
}

/// Histórico de graduações. A graduação atual é o registro mais recente por modalidade.
model StudentRank {
  id         String   @id @default(uuid())
  studentId  String
  modalityId String
  beltId     String
  degree     Int      @default(0)
  promotedAt DateTime @default(now())

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  modality Modality @relation(fields: [modalityId], references: [id], onDelete: Cascade)
  belt     Belt     @relation(fields: [beltId], references: [id])

  @@index([studentId, modalityId, promotedAt])
}

model Plan {
  id                 String   @id @default(uuid())
  academyId          String
  name               String
  priceCents         Int
  /// 1 = mensal, 3 = trimestral, 6 = semestral, 12 = anual
  billingCycleMonths Int      @default(1)
  /// Limite de check-ins por semana (null = livre)
  weeklyLimit        Int?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  academy     Academy        @relation(fields: [academyId], references: [id], onDelete: Cascade)
  modalities  PlanModality[]
  memberships Membership[]
}

model PlanModality {
  planId     String
  modalityId String

  plan     Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  modality Modality @relation(fields: [modalityId], references: [id], onDelete: Cascade)

  @@id([planId, modalityId])
}

model Membership {
  id         String           @id @default(uuid())
  academyId  String
  studentId  String
  planId     String
  priceCents Int
  startDate  DateTime
  endDate    DateTime?
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())

  academy  Academy   @relation(fields: [academyId], references: [id], onDelete: Cascade)
  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([academyId, status])
}

model Invoice {
  id            String         @id @default(uuid())
  academyId     String
  membershipId  String?
  studentId     String
  description   String
  amountCents   Int
  dueDate       DateTime       @db.Date
  status        InvoiceStatus  @default(PENDING)
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  createdAt     DateTime       @default(now())

  academy    Academy     @relation(fields: [academyId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([membershipId, dueDate])
  @@index([academyId, status, dueDate])
}

/// Turma recorrente semanal.
model ClassSchedule {
  id           String  @id @default(uuid())
  academyId    String
  modalityId   String
  instructorId String?
  name         String
  /// 0 = domingo ... 6 = sábado
  weekday      Int
  startTime    String
  endTime      String
  capacity     Int     @default(30)

  academy    Academy   @relation(fields: [academyId], references: [id], onDelete: Cascade)
  modality   Modality  @relation(fields: [modalityId], references: [id], onDelete: Cascade)
  instructor User?     @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  checkIns   CheckIn[]

  @@index([academyId, weekday])
}

model CheckIn {
  id         String   @id @default(uuid())
  academyId  String
  studentId  String
  modalityId String
  classId    String?
  checkedAt  DateTime @default(now())

  academy  Academy        @relation(fields: [academyId], references: [id], onDelete: Cascade)
  student  Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  modality Modality       @relation(fields: [modalityId], references: [id], onDelete: Cascade)
  class    ClassSchedule? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([academyId, checkedAt])
  @@index([studentId, modalityId, checkedAt])
}

model ChatConversation {
  id        String   @id @default(uuid())
  academyId String
  studentId String
  staffId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy  Academy       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  student  Student       @relation("StudentConversations", fields: [studentId], references: [id], onDelete: Cascade)
  staff    User          @relation("StaffConversations", fields: [staffId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([studentId, staffId])
  @@index([academyId, updatedAt])
}

model ChatMessage {
  id             String         @id @default(uuid())
  conversationId String
  senderId       String
  senderRole     ChatSenderRole
  content        String         @db.VarChar(2000)
  createdAt      DateTime       @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Lead {
  id        String     @id @default(uuid())
  academyId String
  name      String
  phone     String?
  email     String?
  source    String?
  interest  String?
  status    LeadStatus @default(NEW)
  notes     String?
  createdAt DateTime   @default(now())

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  @@index([academyId, status])
}

/// Credencial de aparelho para entrar com biometria: o app guarda o segredo no armazenamento seguro
/// do celular e só o libera após digital/Face ID. O banco guarda apenas o hash (SHA-256) do segredo.
model DeviceCredential {
  id         String    @id @default(uuid())
  studentId  String?
  userId     String?
  secretHash String    @unique
  label      String?   @db.VarChar(80)
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([userId])
}

/// Conceito/técnica da trilha de uma faixa. Só aparece para o aluno depois de liberado (`published`).
model TrackLesson {
  id          String        @id @default(uuid())
  academyId   String
  beltId      String
  category    TrackCategory
  title       String        @db.VarChar(120)
  description String?       @db.VarChar(4000)
  mediaId     String?       @unique
  position    Int           @default(0)
  published   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  academy  Academy         @relation(fields: [academyId], references: [id], onDelete: Cascade)
  belt     Belt            @relation(fields: [beltId], references: [id], onDelete: Cascade)
  media    CommunityMedia? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  progress TrackProgress[]

  @@index([academyId, beltId, category, position])
}

/// Conceitos que o aluno marcou como aprendidos.
model TrackProgress {
  studentId   String
  lessonId    String
  completedAt DateTime @default(now())

  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  TrackLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([studentId, lessonId])
  @@index([lessonId])
}
